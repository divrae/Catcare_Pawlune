APP_NAME="Pawlune CatCare"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://catcare.test
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- Database (Laragon: MySQL bawaan, user root tanpa password) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=catcare_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# ---- Info klinik & pembayaran (tampil di struk & kasir) ----
CLINIC_NAME="PAWLUNE CatCare"
CLINIC_ADDRESS="Jl. Melati No. 12, Klaten, Jawa Tengah"
CLINIC_PHONE="0812-0000-1234"
QRIS_MERCHANT="PAWLUNE CATCARE"
BANK1_NAME=BCA
BANK1_NUMBER=1234567890
BANK1_HOLDER="PT Pawlune CatCare"
BANK2_NAME=BRI
BANK2_NUMBER=0987654321
BANK2_HOLDER="PT Pawlune CatCare"
